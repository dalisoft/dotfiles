{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "on",
        "useSortedPackageJson": "on"
      }
    },
    "enabled": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!.vim/plugged",
      "!.config/gcloud",
      "!.config/configstore"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "lineWidth": 80,
    "useEditorconfig": true
  },
  "json": {
    "formatter": {
      "bracketSpacing": true,
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": false
  },
  "vcs": {
    "clientKind": "git",
    "enabled": false,
    "useIgnoreFile": true
  }
}
