{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "86400000",
    "BASH_MAX_TIMEOUT_MS": "86400000",
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_PROXY_RESOLVES_HOSTS": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_UPDATES": "1",
    "FORCE_AUTOUPDATE_PLUGINS": "0",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1",
    "CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_IDE_SKIP_VALID_CHECK": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_DISABLE_FILE_CHECKPOINTING": "1",
    "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN": "0",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "0",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
    "CLAUDE_CODE_ENABLE_TASKS": "1",
    "CLAUDE_AGENT_SDK_DISABLE_BUILTIN_AGENTS": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_DISABLE_FAST_MODE": "1",
    "CLAUDE_CODE_ALWAYS_ENABLE_EFFORT": "1",
    "ENABLE_TOOL_SEARCH": "1",
    "DISABLE_EXTRA_USAGE_COMMAND": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "4",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "20",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1"
  },
  "fallbackModel": [
    "sonnet"
  ],
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "allow": [],
    "ask": [],
    "deny": []
  },
  "hooks": {},
  "cleanupPeriodDays": 90,
  "autoMemoryEnabled": false,
  "model": "opus",
  "enabledPlugins": {},
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "promptSuggestionEnabled": false,
  "askUserQuestionTimeout": "60s",
  "companyAnnouncements": [],
  "autoUpdatesChannel": "latest",
  "plansDirectory": "./.claude/plans",
  "prefersReducedMotion": false,
  "theme": "auto",
  "showTurnDuration": true,
  "terminalProgressBarEnabled": false,
  "disableDeepLinkRegistration": "disable",
  "workflowKeywordTriggerEnabled": false,
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false
  }
}
