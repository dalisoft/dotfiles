{
  "$schema": "https://opencode.ai/tui.json",
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.4
  },
  "cursor": {
    "blinking": true,
    "style": "block"
  },
  "diff_style": "auto",
  "keybinds": {},
  "leader_timeout": 1000,
  "mouse": false,
  "plugin": [],
  "plugin_enabled": {},
  "prompt": {
    "max_height": 10,
    "max_width": "auto"
  },
  "scroll_acceleration": {
    "enabled": true
  },
  "scroll_speed": 3,
  "theme": "system"
}
