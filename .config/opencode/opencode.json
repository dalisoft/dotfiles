{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash#max"
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "opencode-go/kimi-k3#max",
      "permissions": [
        {
          "action": "shell",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "edit",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "skill",
          "effect": "deny",
          "resource": "*"
        }
      ],
      "system": "You are a code reviewer. Focus on security, performance, and maintainability."
    },
    "plan": {
      "mode": "primary",
      "model": "opencode-go/glm-5.3#max",
      "permissions": [
        {
          "action": "shell",
          "effect": "ask",
          "resource": "*"
        },
        {
          "action": "edit",
          "effect": "deny",
          "resource": "*"
        }
      ]
    },
    "title": {
      "model": "opencode-go/mimo-v2.6-flash"
    }
  },
  "autoshare": false,
  "autoupdate": false,
  "commands": {},
  "compaction": {
    "auto": true,
    "buffer": 24576,
    "keep": {
      "tokens": 0
    }
  },
  "default_agent": "build",
  "experimental": {
    "policies": [
      {
        "action": "tool.use",
        "effect": "deny",
        "resource": "shell:sudo *"
      },
      {
        "action": "provider.use",
        "effect": "deny",
        "resource": "*"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "opencode-go"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "opencode"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "zai-coding-plan"
      }
    ],
    "portable_shell_scanner": false,
    "subagent_depth": 1
  },
  "formatter": false,
  "instructions": [],
  "lsp": false,
  "mcp": {
    "servers": {
      "cua-driver": {
        "command": [
          "/opt/homebrew/bin/cua-driver",
          "mcp"
        ],
        "disabled": false,
        "type": "local"
      }
    }
  },
  "media": {
    "image": {
      "auto_resize": true,
      "max_base64_bytes": 5242880,
      "max_height": 2000,
      "max_width": 2000
    }
  },
  "model": "opencode-go/deepseek-v4.1-flash",
  "permissions": [
    {
      "action": "shell",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "edit",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "glob",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "grep",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "lsp",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "question",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "skill",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "todowrite",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "webfetch",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "websearch",
      "effect": "allow",
      "resource": "*"
    },
    {
      "action": "external_directory",
      "effect": "ask",
      "resource": "*"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*.env"
    },
    {
      "action": "read",
      "effect": "deny",
      "resource": "*.env.*"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "*.env.example"
    },
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "/tmp/opencode/*"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "awk *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "bun run *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "cat *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "curl *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "echo *"
    },
    {
      "action": "shell",
