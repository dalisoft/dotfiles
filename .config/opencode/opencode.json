{
  "$schema": "https://opencode.ai/config.json",
  "shell": "fish",
  "small_model": "opencode-go/mimo-v2.5",
  "plugin": [],
  "permission": {
    "bash": "ask",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "deny",
    "read": "allow",
    "skill": "allow",
    "question": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
  },
  "lsp": false,
  "formatter": false,
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 800,
      "max_height": 800,
      "max_base64_bytes": 5242880
    }
  },
  "default_agent": "plan",
  "subagent_depth": 1,
  "mode": {
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "variant": "medium"
    },
    "build": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max"
    }
  },
  "share": "disabled",
  "autoshare": false,
  "compaction": {
    "auto": true,
    "prune": false,
    "reserved": 16384,
    "preserve_recent_tokens": 0
  },
  "snapshot": true,
  "autoupdate": false,
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "mcp": {}
}
