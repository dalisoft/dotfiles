      "resource": "gh api *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "gh pr comment *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh pr list *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "gh pr view *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git add *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git branch *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git clone *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "git commit *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git diff *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git fetch *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git log *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "git push *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git remote *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git rev-parse *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git show *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git stash list"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git stash show *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "git status *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "grep *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "head *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "ls *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "mkdir *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "node *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "npm run *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "npx *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "npx prettier *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "npx tsc *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "readlink *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "rg *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "rm *"
    },
    {
      "action": "shell",
      "effect": "ask",
      "resource": "sh *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "sort"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "stat *"
    },
    {
      "action": "shell",
      "effect": "deny",
      "resource": "sudo *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "tail *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "which *"
    }
  ],
  "plugins": [],
  "providers": {},
  "references": {},
  "share": "disabled",
  "shell": "fish",
  "skills": [],
  "snapshots": false,
  "tool_output": {
    "max_bytes": 51200,
    "max_lines": 2000
  },
  "update": "disable",
  "username": "dalisoft",
  "warming": true,
  "watcher": {
    "ignore": [
      ".git/**",
      "dist/**",
      "node_modules/**"
    ]
  },
  "websearch": {
    "provider": "random"
  }
}
