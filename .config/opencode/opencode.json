{
  "$schema": "https://opencode.ai/config.json",
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_base64_bytes": 5242880,
      "max_height": 800,
      "max_width": 800
    }
  },
  "autoshare": false,
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 0,
    "prune": false,
    "reserved": 16384
  },
  "default_agent": "plan",
  "formatter": false,
  "lsp": false,
  "mcp": {},
  "mode": {
    "build": {
      "model": "opencode-go/deepseek-v4-flash",
      "mode": "primary",
      "variant": "max",
      "permission": {
        "bash": {
          "*": "ask",
          "git status *": "allow",
          "git diff *": "allow"
        },
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "deny",
        "question": "ask",
        "read": "allow",
        "skill": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "mode": "primary",
      "variant": "medium",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "lsp": "deny",
        "question": "allow",
        "read": "allow",
        "skill": "deny",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "deny"
      }
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "opencode-go/kimi-k3",
      "variant": "max",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "lsp": "deny",
        "question": "deny",
        "read": "allow",
        "skill": "deny",
        "todowrite": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  },
  "permission": {
    "bash": "ask",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "deny",
    "question": "allow",
    "read": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "plugin": [],
  "share": "disabled",
  "shell": "fish",
  "small_model": "opencode-go/mimo-v2.5",
  "snapshot": true,
  "subagent_depth": 1,
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
  "provider": {
    "modelscope-ai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ModelScope AI",
      "options": {
        "baseURL": "https://api-inference.modelscope.ai/v1",
        "setCacheKey": true
      },
      "models": {
        "Qwen-Ambassador/Qwen3.8-Max": {
          "id": "vercel/alibaba/qwen3.8-max-0902",
          "name": "[QA] Qwen3.8 Max",
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          }
        },
        "Qwen-Ambassador/Qwen3.7-Max": {
          "id": "vercel/alibaba/qwen3.7-max",
          "name": "[QA] Qwen3.7 Max",
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "Qwen-Ambassador/Qwen3.8-27B": {
          "id": "vercel/alibaba/qwen3.8-27b",
          "name": "[QA] Qwen3.8-27B",
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          }
        },
        "Qwen-Ambassador/Qwen3.7-Plus": {
          "id": "vercel/alibaba/qwen3.7-plus",
          "name": "[QA] Qwen3.7 Plus",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      }
    }
  }
}
