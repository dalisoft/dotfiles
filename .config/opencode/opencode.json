{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "build": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash#high"
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "opencode-go/kimi-k3.1-pro#max",
      "permissions": [
        {
          "action": "shell",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "edit",
          "effect": "deny",
          "resource": "*"
        },
        {
          "action": "skill",
          "effect": "deny",
          "resource": "*"
        }
      ],
      "system": "You are a code reviewer. Focus on security, performance, and maintainability."
    },
    "plan": {
      "mode": "primary",
      "model": "zai-coding-plan/glm-5.3#max",
      "permissions": [
        {
          "action": "shell",
          "effect": "ask",
          "resource": "*"
        },
        {
          "action": "edit",
          "effect": "deny",
          "resource": "*"
        }
      ]
    },
    "title": {
      "model": "opencode-go/mimo-v2.6-flash"
    }
  },
  "commands": {},
  "compaction": {
    "auto": true,
    "buffer": 28000,
    "keep": {
      "tokens": 0
    }
  },
  "default_agent": "build",
  "experimental": {
    "artifacts": false,
    "background_compaction": true,
    "image_generate": true,
    "location_idle_timeout": "60 minutes",
    "policies": [
      {
        "action": "tool.use",
        "effect": "deny",
        "resource": "shell:sudo *"
      },
      {
        "action": "provider.use",
        "effect": "deny",
        "resource": "*"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "opencode-go"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "opencode"
      },
      {
        "action": "provider.use",
        "effect": "allow",
        "resource": "zai-coding-plan"
      }
    ],
    "portable_shell_scanner": false,
    "subagent_depth": 1,
    "todo": true
  },
  "formatter": false,
  "instructions": [],
  "lsp": false,
  "mcp": {
    "servers": {}
  },
  "media": {
    "image": {
      "auto_resize": true,
      "max_base64_bytes": 5242880,
      "max_height": 2000,
      "max_width": 2000
    }
  },
