{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "opencode-go/kimi-k3",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "lsp": "deny",
        "question": "deny",
        "read": "allow",
        "skill": "deny",
        "todowrite": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      },
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "variant": "max"
    }
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_base64_bytes": 5242880,
      "max_height": 2000,
      "max_width": 2000
    }
  },
  "autoshare": false,
  "autoupdate": false,
  "command": {},
  "compaction": {
    "auto": true,
    "preserve_recent_tokens": 8192,
    "prune": true,
    "reserved": 32768
  },
  "default_agent": "build",
  "disabled_providers": [],
  "enabled_providers": [
    "opencode-go",
  ],
  "experimental": {},
  "formatter": false,
  "instructions": [],
  "logLevel": "ERROR",
  "lsp": false,
  "mcp": {},
  "mode": {
    "build": {
      "mode": "primary",
      "model": "opencode-go/muse-spark-1.3-contributor",
      "permission": {
        "bash": {
          "*": "ask",
          "git diff *": "allow",
          "git status *": "allow"
        },
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "lsp": "deny",
        "question": "ask",
        "read": "allow",
        "skill": "allow",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      },
      "variant": "max"
    },
    "plan": {
      "mode": "primary",
      "model": "opencode-go/glm-5.3",
      "permission": {
        "bash": "deny",
        "edit": "deny",
        "glob": "allow",
        "grep": "allow",
        "lsp": "deny",
        "question": "allow",
        "read": "allow",
        "skill": "deny",
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "deny"
      },
      "variant": "high"
    }
  },
  "model": "opencode-go/muse-spark-1.3-contributor",
  "permission": {
    "bash": "ask",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "deny",
    "question": "allow",
    "read": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },
  "plugin": [],
  "provider": {},
  "references": {},
  "server": {},
  "share": "disabled",
  "shell": "fish",
  "skills": {
    "paths": [],
    "urls": []
  },
  "small_model": "opencode-go/mimo-v2.5",
  "snapshot": false,
  "subagent_depth": 1,
  "tool_output": {
    "max_bytes": 51200,
    "max_lines": 2000
  },
  "tools": {},
  "username": "dalisoft",
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  }
}
