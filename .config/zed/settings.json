	},
	"indent_guides": {
		"active_line_width": 1,
		"background_coloring": "disabled",
		"coloring": "indent_aware",
		"enabled": true,
		"line_width": 1
	},
	"indent_list_on_tab": true,
	"inlay_hints": {
		"edit_debounce_ms": 700,
