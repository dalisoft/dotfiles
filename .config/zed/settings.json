	"line_ending": "detect",
	"line_indicator_format": "long",
	"linked_edits": true,
	"linux": {},
	"load_direnv": "direct",
	"log": {},
	"lsp": {
		"biome": {
			"settings": {
				"require_config_file": true
			}
		},
		"tsgo": {
			"settings": {
				"goMemLimit": "4GiB",
				"javascript": {
					"inlayHints": {
						"functionLikeReturnTypes": {
							"enabled": false
						},
						"parameterNames": {
							"enabled": "none"
						},
						"parameterTypes": {
							"enabled": false
						},
						"propertyDeclarationTypes": {
							"enabled": false
						},
						"variableTypes": {
							"enabled": false
						}
					},
					"preferences": {
						"importModuleSpecifier": "non-relative",
						"importModuleSpecifierEnding": "minimal",
						"preferTypeOnlyAutoImports": true
					},
					"suggest": {
						"autoImports": true,
						"classMemberSnippets.enabled": true,
						"completeFunctionCalls": true,
