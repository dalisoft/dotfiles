{
	"$schema": "zed://schemas/settings",
	"accessible_mode": false,
	"active_pane_modifiers": {
		"border_size": 0.0,
		"inactive_opacity": 1.0
	},
	"agent": {
		"auto_compact": {
			"enabled": true,
			"threshold": "90%"
		},
		"button": true,
		"cancel_generation_on_terminal_stop": true,
		"commit_message_include_project_rules": true,
		"default_height": 320,
		"default_model": {
			"effort": "high",
			"enable_thinking": true,
			"model": "gpt-5.5",
			"provider": "openai",
			"speed": "standard"
		},
		"default_profile": "minimal",
		"default_width": 540,
		"dock": "right",
		"enable_feedback": true,
		"enabled": false,
		"expand_edit_card": true,
		"expand_terminal_card": true,
		"flexible": false,
		"inline_alternatives": [
			{
				"effort": "high",
				"enable_thinking": true,
				"model": "claude-sonnet-5",
				"provider": "anthropic",
				"speed": "standard"
			},
			{
				"effort": "high",
				"enable_thinking": true,
				"model": "gpt-5.4-mini",
				"provider": "openai",
				"speed": "standard"
			}
		],
		"inline_assistant_model": {
			"effort": "high",
			"enable_thinking": true,
			"model": "gemini-3.5-flash",
			"provider": "google",
			"speed": "standard"
		},
		"inline_assistant_use_streaming_tools": true,
		"limit_content_width": true,
		"max_content_width": 850,
		"max_idle_retained_threads": 5,
		"message_editor_min_lines": 4,
		"model_parameters": [],
		"notify_when_agent_waiting": "primary_screen",
		"play_sound_when_agent_done": "never",
		"prevent_idle_sleep": true,
		"profiles": {
			"ask": {
				"name": "Ask",
				"tools": {
					"create_thread": true,
					"diagnostics": true,
					"fetch": true,
					"find_path": true,
					"find_references": true,
					"get_code_actions": true,
					"go_to_definition": true,
					"grep": true,
					"list_agents_and_models": true,
					"list_directory": true,
					"read_file": true,
					"search_web": true,
					"skill": true,
					"spawn_agent": true
				}
			},
			"minimal": {
				"enable_all_context_servers": false,
				"name": "Minimal",
				"tools": {}
			},
			"write": {
				"enable_all_context_servers": true,
				"name": "Write",
				"tools": {
					"apply_code_action": true,
					"copy_path": true,
					"create_directory": true,
					"create_thread": true,
					"delete_path": true,
					"diagnostics": true,
					"edit_file": true,
					"fetch": true,
					"find_path": true,
					"find_references": true,
					"get_code_actions": true,
					"go_to_definition": true,
					"grep": true,
					"list_agents_and_models": true,
					"list_directory": true,
					"move_path": true,
					"read_file": true,
					"rename_symbol": true,
					"search_web": true,
					"skill": true,
					"spawn_agent": true,
					"terminal": true,
					"write_file": true
				}
			}
		},
		"show_merge_conflict_indicator": true,
		"show_turn_stats": true,
		"single_file_review": false,
		"terminal_init_command": "",
		"thinking_display": "auto",
		"threads_sidebar": {
			"auto_open": true,
			"default_width": 300,
			"position": "left"
		},
		"tool_permissions": {
			"default": "allow"
		},
		"use_modifier_to_send": false
	},
	"agent_buffer_font_family": null,
	"agent_buffer_font_size": 12,
	"agent_servers": {},
	"agent_ui_font_family": null,
	"agent_ui_font_size": null,
	"allow_rewrap": "in_comments",
	"always_treat_brackets_as_autoclosed": false,
	"audio": {
		"experimental.input_audio_device": null,
		"experimental.output_audio_device": null
	},
	"auto_indent": "syntax_aware",
	"auto_indent_on_paste": false,
	"auto_install_extensions": {
		"basher": true,
		"biome": true,
		"docker-compose": true,
		"dockerfile": true,
		"dprint": true,
		"env": true,
		"fish": true,
		"git-firefly": true,
		"html": true,
		"java": true,
		"log": true,
		"material-icon-theme": true,
		"mdx": true,
		"mermaid": true,
		"nginx": true,
		"oxc": true,
		"php": true,
		"powershell": true,
		"prisma": true,
		"quiet-light-theme": true,
		"r": true,
		"rainbow-csv": true,
		"ruby": true,
		"scss": true,
		"sql": true,
		"svelte": true,
		"terraform": true,
		"toml": true,
		"tsgo": true,
		"typos": true,
		"xml": true,
		"zig": true
	},
	"auto_signature_help": true,
	"auto_update": false,
	"autosave": "on_window_change",
	"autoscroll_on_clicks": false,
	"base_keymap": "VSCode",
	"bottom_dock_layout": "contained",
	"buffer_font_fallbacks": [
		"Fira Code",
		"Monaco"
	],
	"buffer_font_family": "JetBrains Mono NL",
	"buffer_font_features": {
		"calt": true,
		"liga": true
	},
	"buffer_font_size": 14,
	"buffer_font_weight": 400,
	"buffer_line_height": {
		"custom": 1.5
	},
	"call_hierarchy": {
		"modal_max_width": "medium"
	},
	"calls": {
		"mute_on_join": false,
		"share_on_join": false
	},
	"centered_layout": {
		"left_padding": 0.2,
		"right_padding": 0.2
	},
	"cli_default_open_behavior": "existing_window",
	"close_on_file_delete": true,
	"close_panel_on_toggle": false,
	"code_actions_on_format": {},
	"code_lens": "on",
	"collaboration_panel": {
		"button": false,
		"default_width": 240,
		"dock": "left"
	},
	"colorize_brackets": true,
	"command_palette": {
		"use_command_history": true
	},
	"completion_detail_alignment": "left",
	"completion_menu_item_kind": "off",
	"completion_menu_scrollbar": "never",
	"completions": {
		"lsp": true,
		"lsp_fetch_timeout_ms": 0,
		"lsp_insert_mode": "replace_suffix",
		"words": "fallback",
		"words_min_length": 3
	},
	"confirm_quit": true,
	"context_server_timeout": 60,
	"copilot": {
		"enterprise_uri": null
	},
	"current_line_highlight": "all",
	"cursor_animation": {
		"enabled": false
	},
	"cursor_blink": true,
	"cursor_shape": "bar",
	"debugger": {
		"button": true,
		"dock": "bottom",
		"format_dap_log_messages": true,
		"log_dap_communications": true,
		"save_breakpoints": true,
		"stepping_granularity": "line",
		"timeout": 2000
	},
	"default_open_behavior": "existing_window",
	"dev": {
		"instrumentation": {
			"performance_profiler": {
				"enabled": true
			}
		}
	},
	"diagnostics": {
		"button": true,
		"include_warnings": true,
		"inline": {
			"enabled": false,
			"max_severity": null,
			"min_column": 0,
			"padding": 4,
			"update_debounce_ms": 150
		},
		"lsp_pull_diagnostics": {
			"debounce_ms": 50,
			"enabled": true
		}
	},
	"diagnostics_max_severity": "all",
	"diff_view_style": "split",
	"disable_ai": true,
	"document_folding_ranges": "off",
	"document_symbols": "off",
	"double_click_in_multibuffer": "select",
	"drag_and_drop_selection": {
		"delay": 300,
		"enabled": true
	},
	"drop_target_size": 0.2,
	"edit_predictions": {
		"allow_data_collection": "no",
		"codestral": {
			"api_url": "https://codestral.mistral.ai",
			"max_tokens": 150,
			"model": "codestral-latest",
			"prediction_debounce": 150
		},
		"copilot": {
			"enable_next_edit_suggestions": true,
			"prediction_debounce": 75,
			"proxy": null,
			"proxy_no_verify": null
		},
		"disabled_globs": [
			"**/.env*",
			"**/*.pem",
			"**/*.key",
			"**/*.cert",
			"**/*.crt",
			"**/.dev.vars",
			"**/secrets.yml",
			"**/.zed/settings.json",
			"/**/zed/settings.json",
			"/**/zed/keymap.json"
		],
		"mercury": {
			"prediction_debounce": 0
		},
		"mode": "eager",
		"ollama": {
			"api_url": "http://localhost:11434",
			"max_output_tokens": 64,
			"model": "qwen2.5-coder:7b-base",
			"prediction_debounce": 0,
			"prompt_format": "infer"
		},
		"open_ai_compatible_api": {
			"api_url": "",
			"max_output_tokens": 64,
			"model": "",
			"prediction_debounce": 0,
			"prompt_format": "infer"
		},
		"provider": "zed",
		"zed": {
			"prediction_debounce": 0
		}
	},
	"edit_predictions_disabled_in": [],
	"enable_language_server": true,
	"ensure_final_newline_on_save": false,
	"excerpt_context_lines": 2,
	"expand_excerpt_lines": 5,
	"extend_comment_on_newline": true,
	"extend_list_on_newline": true,
	"fast_scroll_sensitivity": 4.0,
	"file_finder": {
		"file_icons": true,
		"include_channels": false,
		"include_ignored": "smart",
		"modal_max_width": "small",
		"prefill_query_from_selection": true,
		"skip_focus_for_active_in_search": true
	},
	"file_scan_depth": 5,
	"file_scan_exclusions": [
		"**/.DS_Store",
		"**/.cache",
		"**/.classpath",
		"**/.git",
		"**/.hg",
		"**/.history",
		"**/.idea",
		"**/.jj",
		"**/.out",
		"**/.repo",
		"**/.settings",
		"**/.sl",
		"**/.svn",
		"**/.trunk",
		"**/.vscode",
		"**/.webpack",
		"**/CVS",
		"**/Thumbs.db",
		"**/bower_components",
		"**/bower_packages",
		"**/build",
		"**/dist",
		"**/node_modules",
		"**/public",
		"**/tmp"
	],
	"file_scan_inclusions": [
		".env*"
	],
	"file_types": {
		"Git Attributes": [
			"**/{git,.git,.git/info}/attributes"
		],
		"Git Config": [
			"*.gitconfig",
			"**/{git,.git/modules,.git/modules/*}/config"
		],
		"Git Ignore": [
			"**/{git,.git}/ignore",
			"**/.git/info/exclude"
		],
		"Git Modules": [
			".gitmodules"
		],
		"JavaScript": [
			"*.js"
		],
		"JSONC": [
			"*.sublime-settings",
			".prettierrc"
		],
		"TypeScript": [
			"*.ts"
		]
	},
	"focus_follows_mouse": {
		"debounce_ms": 250,
		"enabled": false
	},
	"format_on_save": "on",
	"formatter": "auto",
	"fullscreen_mode": "native",
	"git": {
		"blame": {
			"show_avatar": true
		},
		"branch_picker": {
			"show_author_name": true
		},
		"diff_base": "head",
		"disable_git": false,
		"enable_diff": true,
		"enable_status": true,
		"file_diff": {
			"show_full_file": true
		},
		"git_gutter": "tracked_files",
		"gutter_debounce": 0,
