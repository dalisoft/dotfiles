	"git_commit_buffer_font_size": 14,
	"git_panel": {
		"button": true,
		"collapse_untracked_diff": false,
		"commit_editor": "expanded",
		"commit_title_max_length": 60,
		"default_width": 320,
		"diff_stats": true,
		"dock": "left",
		"entry_primary_click_action": "project_diff",
		"fallback_branch_name": "main",
		"file_icons": true,
		"folder_indicator": "icon",
